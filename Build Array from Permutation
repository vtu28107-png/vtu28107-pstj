class Solution {
    public int[] buildArray(int[] nums) {
        int n = nums.length;
        
        // Pass 1: Encode both old and new values in nums[i]
        for (int i = 0; i < n; i++) {
            int newValue = nums[nums[i]] % n; // Extract old value of nums[nums[i]]
            nums[i] = nums[i] + n * newValue;
        }
        
        // Pass 2: Extract the new values
        for (int i = 0; i < n; i++) {
            nums[i] = nums[i] / n;
        }
        
        return nums;
    }
}
