class Solution {
    public int[] shuffle(int[] nums, int n) {
        // Pass 1: Pack x_i and y_i together into the second half of the array
        for (int i = 0; i < n; i++) {
            nums[i + n] = (nums[i] << 10) | nums[i + n];
        }
        
        // Pass 2: Unpack values from second half into their final indices
        for (int i = 0; i < n; i++) {
            int x = nums[i + n] >> 10;
            int y = nums[i + n] & 1023; // 1023 is 2^10 - 1 (10 bits mask)
            
            nums[2 * i] = x;
            nums[2 * i + 1] = y;
        }
        
        return nums;
    }
}
