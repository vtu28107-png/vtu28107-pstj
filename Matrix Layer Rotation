import java.io.*;
import java.util.*;
import java.util.stream.*;
import static java.util.stream.Collectors.toList;

class Result {

    /*
     * Complete the 'matrixRotation' function below.
     *
     * The function accepts following parameters:
     *  1. 2D_INTEGER_ARRAY matrix
     *  2. INTEGER r
     */

    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        int numLayers = Math.min(m, n) / 2;

        for (int l = 0; l < numLayers; l++) {
            List<Integer> layer = new ArrayList<>();

            // 1. Extract Top Row
            for (int j = l; j < n - l; j++) {
                layer.add(matrix.get(l).get(j));
            }
            // 2. Extract Right Column
            for (int i = l + 1; i < m - l - 1; i++) {
                layer.add(matrix.get(i).get(n - 1 - l));
            }
            // 3. Extract Bottom Row
            for (int j = n - 1 - l; j >= l; j--) {
                layer.add(matrix.get(m - 1 - l).get(j));
            }
            // 4. Extract Left Column
            for (int i = m - 2 - l; i > l; i--) {
                layer.add(matrix.get(i).get(l));
            }

            int len = layer.size();
            int effR = r % len;

            // Rotate array elements anti-clockwise
            List<Integer> rotated = new ArrayList<>(len);
            for (int k = 0; k < len; k++) {
                rotated.add(layer.get((k + effR) % len));
            }

            // Write rotated values back to the matrix
            int idx = 0;
            for (int j = l; j < n - l; j++) {
                matrix.get(l).set(j, rotated.get(idx++));
            }
            for (int i = l + 1; i < m - l - 1; i++) {
                matrix.get(i).set(n - 1 - l, rotated.get(idx++));
            }
            for (int j = n - 1 - l; j >= l; j--) {
                matrix.get(m - 1 - l).set(j, rotated.get(idx++));
            }
            for (int i = m - 2 - l; i > l; i--) {
                matrix.get(i).set(l, rotated.get(idx++));
            }
        }

        // Print the result matrix
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(matrix.get(i).get(j)).append(j == n - 1 ? "" : " ");
            }
            sb.append("\n");
        }
        System.out.print(sb);
    } // Closing matrixRotation method
} // Closing Result class

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));
        String[] firstMultipleInput = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

        int m = Integer.parseInt(firstMultipleInput[0]);
        int n = Integer.parseInt(firstMultipleInput[1]);
        int r = Integer.parseInt(firstMultipleInput[2]);

        List<List<Integer>> matrix = new ArrayList<>();

        IntStream.range(0, m).forEach(i -> {
            try {
                matrix.add(
                    Stream.of(bufferedReader.readLine().replaceAll("\\s+$", "").split(" "))
                        .map(Integer::parseInt)
                        .collect(toList())
                );
            } catch (IOException ex) {
                throw new RuntimeException(ex);
            }
        });

        Result.matrixRotation(matrix, r);

        bufferedReader.close();
    }
}
