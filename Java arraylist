import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        // Read total number of lines
        int n = scanner.nextInt();
        
        // List to store each line as an ArrayList of Integers
        ArrayList<ArrayList<Integer>> lines = new ArrayList<>();
        
        for (int i = 0; i < n; i++) {
            int d = scanner.nextInt();
            ArrayList<Integer> line = new ArrayList<>();
            for (int j = 0; j < d; j++) {
                line.add(scanner.nextInt());
            }
            lines.add(line);
        }
        
        // Read number of queries
        int q = scanner.nextInt();
        
        for (int i = 0; i < q; i++) {
            int x = scanner.nextInt(); // 1-based line number
            int y = scanner.nextInt(); // 1-based position number
            
            // Convert 1-based input coordinates to 0-based list indices
            int lineIdx = x - 1;
            int posIdx = y - 1;
            
            // Bounds check for valid line and position
            if (lineIdx >= 0 && lineIdx < lines.size() && posIdx >= 0 && posIdx < lines.get(lineIdx).size()) {
                System.out.println(lines.get(lineIdx).get(posIdx));
            } else {
                System.out.println("ERROR!");
            }
        }
        
        scanner.close();
    }
}
