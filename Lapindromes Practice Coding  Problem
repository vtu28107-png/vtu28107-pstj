def solve():
    import sys

    input = sys.stdin.read
    data = input().split()

    if not data:
        return

    t = int(data[0])
    results = []

    for i in range(1, t + 1):
        s = data[i]
        n = len(s)

        # Find middle index and slice left and right halves
        left = s[: n // 2]
        right = s[(n + 1) // 2 :]

        # Compare sorted versions of both halves
        if sorted(left) == sorted(right):
            results.append("YES")
        else:
            results.append("NO")

    print("\n".join(results))


if __name__ == "__main__":
    solve()
