class Solution {
public:
    bool halvesAreAlike(string s) {
        unordered_set<char> vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'};
        int leftVowels = 0, rightVowels = 0;
        int n = s.length();
        int mid = n / 2;

        for (int i = 0; i < mid; i++) {
            if (vowels.count(s[i])) {
                leftVowels++;
            }
            if (vowels.count(s[i + mid])) {
                rightVowels++;
            }
        }

        return leftVowels == rightVowels;
    }
};
